# ---------- Colors ----------
R='\e[1;31m'; G='\e[1;32m'; Y='\e[1;33m'
C='\e[1;36m'; B='\e[1;34m'; M='\e[1;35m'; N='\e[0m'

# ---------- Banner Function ----------
print_banner() {
    local target=$1
    echo -e "${M}"
    echo "  _     ____    ____  _  __       _____ _   _ _____ "
    echo " | |   |  _ \  / ___|| |/ /      |  ___| | | |_   _|"
    echo " | |   | | | | \___ \| ' /  _____| |_  | | | | | |  "
    echo " | |___| |_| |  ___) | . \ |_____|  _| | |_| | | |  "
    echo " |_____|____/  |____/|_|\_\      |_|    \___/  |_|  "
    echo -e "${N}"
    echo -e "${C}  Low-Hanging Fruits - Automated Bug Bounty Recon${N}"
    echo -e "${Y}  Target: ${B}${target}${N}"
    echo ""
}

# ---------- Load Configuration Function ----------
load_config() {
    CONFIG_FILE="$HOME/lhf/config.conf"
    if [ -f "$CONFIG_FILE" ]; then
        # دستور source فایل کانفیگ را می‌خواند و متغیرهای داخل آن را در محیط فعلی تعریف می‌کند
        source "$CONFIG_FILE"
        echo -e "${G}[✓] Configuration loaded successfully.${N}"
    else
        echo -e "${R}[✗] Error: config.conf not found at $CONFIG_FILE${N}"
        echo -e "${R}    Please run Phase 1 setup first.${N}"
        exit 1
    fi
}

# ---------- Setup Scan Directory Function ----------
setup_scan_dir() {
    local target=$1
    local timestamp=$(date +"%Y%m%d_%H%M%S")
    
    # امن‌سازی نام دامنه (حذف کاراکترهای غیرمجاز برای نام پوشه)
    local safe_target=$(echo "$target" | sed 's/[^a-zA-Z0-9._-]/_/g')
    
    # ساخت مسیر یکتای اسکن
    SCAN_DIR="$LHF_HOME/scans/${safe_target}_${timestamp}"
    
    # ساخت زیرپوشه‌های ایزوله برای هر فاز
    mkdir -p "$SCAN_DIR"/{subs,ports,http,urls,vulns,secrets,screenshots,takeover,reports,tmp}
    
    echo -e "${G}[✓] Scan directory created: ${SCAN_DIR}${N}"
    
    # ذخیره مسیر آخرین اسکن برای استفاده در دیباگ یا ادامه اسکن
    echo "$SCAN_DIR" > "$LHF_HOME/tmp/last_scan_dir.txt"
}

# ---------- Main Logic Function ----------
main() {
    # ۱. بررسی ورودی‌ها
    if [ -z "$1" ]; then
        echo -e "${R}[✗] Error: No target specified.${N}"
        echo -e "${Y}Usage: $0 <target.com>${N}"
        exit 1
    fi
    
    TARGET="$1"
    
    # ۲. اجرای مراحل راه‌اندازی
    print_banner "$TARGET"
    load_config
    setup_scan_dir "$TARGET"
    
    # ۳. نمایش خلاصه وضعیت موتور
    echo ""
    echo -e "${B}[+] [LHF] Engine initialized successfully.${N}"
    echo -e "${C}    Target:  ${TARGET}${N}"
    echo -e "${C}    Profile: ${PROFILE}${N}"
    echo -e "${C}    Threads: ${THREADS}${N}"
    echo -e "${C}    Output:  ${SCAN_DIR}${N}"
    echo ""
    echo -e "${Y}[i] Phase 3, Step 1 completed. Core structure is ready.${N}"
    echo -e "${C}[i] Next steps will add the actual scanning logic.${N}"
}

# اجرای تابع اصلی با تمام آرگومان‌های دریافتی از خط فرمان
main "$@"
